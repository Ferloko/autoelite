# Destino de los formularios (puede ser Gmail; no va en el frontend)
CONTACT_EMAIL=ventas@autoelite.com

# Orígenes permitidos para POST /api/send-email (coma-separados)
# En producción: https://tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Local: simula envío en la consola sin API key (no usar en producción)
EMAIL_DEV_LOG=true

# Proveedor de envío (elige Resend o Brevo; las claves solo en el servidor)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Auto Élite <onboarding@resend.dev>

BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=verified_sender@yourdomain.com
BREVO_SENDER_NAME=Auto Élite
